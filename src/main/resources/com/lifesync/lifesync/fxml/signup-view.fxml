<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    signup-view.fxml
    Sign-up / registration screen for LifeSync application with integrated BMI system.
    Split layout: left brand panel (warm gradient), right registration form with personal & BMI metrics.
    Controller: com.lifesync.lifesync.controller.SignUpController
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.lifesync.lifesync.controller.SignUpController"
      prefHeight="720.0" prefWidth="1100.0"
      styleClass="login-root">

    <!-- ==================== LEFT PANEL: Brand Area ==================== -->
    <VBox prefWidth="380" alignment="CENTER" spacing="12"
          styleClass="login-brand-panel">
        <padding>
            <Insets top="35" right="40" bottom="35" left="40"/>
        </padding>

        <!-- Top brand title with leaf icon -->
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label text="🌿 LifeSync" styleClass="brand-title"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Mascot Illustration - Prominent hero placement with transparent alpha -->
        <VBox alignment="CENTER" spacing="12">
            <ImageView fitHeight="200" fitWidth="200" preserveRatio="true">
                <image>
                    <Image url="@../images/login.png"/>
                </image>
            </ImageView>

            <!-- Welcome heading block -->
            <Label text="Welcome to LifeSync" styleClass="brand-heading" textAlignment="CENTER"/>
            <Label text="Plan. Eat. Move. Grow.&#10;All in one place."
                   styleClass="brand-subtitle" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Motivational motto -->
        <Label text="Small steps build great changes! 🌱"
               styleClass="brand-motto" wrapText="true" textAlignment="CENTER"/>
    </VBox>

    <!-- ==================== RIGHT PANEL: Scrollable Sign-Up Form ==================== -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true"
                styleClass="signup-scroll-pane"
                hbarPolicy="NEVER">
        <VBox alignment="CENTER" styleClass="login-form-panel">
            <padding>
                <Insets top="35" right="50" bottom="35" left="50"/>
            </padding>

            <!-- Form container with max width for readability -->
            <VBox maxWidth="480" spacing="10" alignment="CENTER_LEFT">

                <!-- Heading -->
                <Label text="🌿 Create your account" styleClass="form-heading"/>
                <Label text="Let's personalize your lifestyle with your body &amp; fitness profile."
                       styleClass="form-subtitle" wrapText="true"/>

                <Region prefHeight="6"/>

                <!-- ── Section 1: Account Information ── -->
                <Label text="Account Credentials"
                       styleClass="signup-section-heading"/>

                <!-- First Name + Last Name side by side -->
                <HBox spacing="10">
                    <TextField fx:id="firstNameField"
                               promptText="First Name"
                               styleClass="login-field"
                               HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="lastNameField"
                               promptText="Last Name"
                               styleClass="login-field"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Username + Email side by side -->
                <HBox spacing="10">
                    <TextField fx:id="usernameField"
                               promptText="Username"
                               styleClass="login-field"
                               HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="emailField"
                               promptText="Email Address"
                               styleClass="login-field"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Password + Confirm Password side by side -->
                <HBox spacing="10">
                    <PasswordField fx:id="passwordField"
                                   promptText="Password (min 6 chars)"
                                   styleClass="login-field"
                                   HBox.hgrow="ALWAYS"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Confirm Password"
                                   styleClass="login-field"
                                   HBox.hgrow="ALWAYS"/>
                </HBox>

                <Separator/>

                <!-- ── Section 2: Anthropometrics & BMI Setup ── -->
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="📊 Body Metrics &amp; BMI Setup"
                           styleClass="signup-section-heading"/>
                    <Label text="(Used to calculate BMI &amp; energy needs)"
                           styleClass="signup-section-sub"/>
                </HBox>

                <!-- Age & Gender -->
                <HBox spacing="10">
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Age" styleClass="signup-field-label"/>
                        <TextField fx:id="ageField"
                                   promptText="e.g. 21"
                                   styleClass="login-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Biological Sex" styleClass="signup-field-label"/>
                        <ComboBox fx:id="genderCombo"
                                  promptText="Select Gender"
                                  maxWidth="Infinity"
                                  prefHeight="42"/>
                    </VBox>
                </HBox>

                <!-- Height & Weight -->
                <HBox spacing="10">
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Height (cm)" styleClass="signup-field-label"/>
                        <TextField fx:id="heightField"
                                   promptText="e.g. 170"
                                   styleClass="login-field"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                        <Label text="Weight (kg)" styleClass="signup-field-label"/>
                        <TextField fx:id="weightField"
                                   promptText="e.g. 65"
                                   styleClass="login-field"/>
                    </VBox>
                </HBox>

                <!-- Activity Level -->
                <VBox spacing="3">
                    <Label text="Physical Activity Level" styleClass="signup-field-label"/>
                    <ComboBox fx:id="activityLevelCombo"
                              promptText="Select Activity Level"
                              maxWidth="Infinity"
                              prefHeight="42"/>
                </VBox>

                <!-- Dietary Preferences / Restrictions -->
                <VBox spacing="3">
                    <Label text="Dietary Preferences &amp; Restrictions" styleClass="signup-field-label"/>
                    <TextField fx:id="dietaryPreferencesField"
                               promptText="e.g. Lactose-Free, Vegetarian, Vegan, Halal, Nut Allergy, or None"
                               styleClass="login-field"/>
                </VBox>

                <!-- Live BMI preview note box -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="signup-note-box">
                    <Label text="💡" styleClass="bmi-focus-icon"/>
                    <Label text="Your BMI and daily energy goals are calculated upon sign-up. The app adapts recipes and workouts to your body metrics!"
                           wrapText="true"
                           styleClass="signup-note-text"/>
                </HBox>

                <Region prefHeight="4"/>

                <!-- Sign Up button -->
                <Button text="Calculate BMI &amp; Create Account →"
                        onAction="#handleSignUp"
                        styleClass="login-button"
                        maxWidth="Infinity"/>

                <!-- Error label (initially empty) -->
                <Label fx:id="errorLabel" text=""
                       styleClass="error-label" wrapText="true"/>

                <Region prefHeight="6"/>

                <!-- Login prompt -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Already have an account?" styleClass="form-footer-text"/>
                    <Hyperlink text="Log in →"
                               onAction="#handleBack"
                               styleClass="form-link"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
